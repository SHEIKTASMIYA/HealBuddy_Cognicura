# Copy this file to .env and fill in your existing Supabase project's values.
# Never put a service_role key here — only the public anon key, which is safe
# for the browser because Row Level Security (RLS) on your tables enforces
# that each user can only read/write rows where user_id = auth.uid().

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Name of the Storage bucket reports are uploaded to (must already exist).
VITE_SUPABASE_REPORTS_BUCKET=reports

# Name of an Edge Function (already deployed on your project) that extracts
# and summarizes an uploaded report. If you don't have one yet, the app will
# show reports stuck in "processing" — see README.md "Report processing".
VITE_SUPABASE_PROCESS_REPORT_FUNCTION=process-report
